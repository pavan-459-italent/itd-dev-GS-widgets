{
  "connectors": [
    {
      "name": "REST Countries",
      "url": "https://restcountries.com/v3.1/all",
      "method": "GET",
      "headers": [
        {
          "key": "Accept",
          "value": "application/json",
          "overridable": false
        }
      ],
      "query_parameters": [
        {
          "key": "fields",
          "value": "name,capital,population,flags,region",
          "overridable": false
        }
      ],
      "permalink": "rest-countries",
      "response_content_type": "application/json"
    },
    {
      "name": "ServiceNow Cases",
      "permalink": "servicenow-cases",
      "url": "https://dev438610.service-now.com/api/now/table/incident",
      "method": "GET",
      "authentication": {
        "type": "none"
      },
      "headers": [
        {
          "key": "Accept",
          "value": "application/json",
          "overridable": false
        },
        {
          "key": "Authorization",
          "value": "Basic {{ get_secret('servicenow_basic_auth_token') }}",
          "overridable": false
        }
      ],
      "query_parameters": [
        {
          "key": "sysparm_query",
          "value": "active=true",
          "overridable": false
        },
        {
          "key": "sysparm_fields",
          "value": "sys_id,number,short_description,description,state,priority,opened_at,opened_by",
          "overridable": false
        },
        {
          "key": "sysparm_exclude_reference_link",
          "value": "true",
          "overridable": false
        }
      ],
      "response_content_type": "application/json"
    },
    {
      "name": "ServiceNow Case Create",
      "permalink": "servicenow-case-create",
      "url": "https://dev438610.service-now.com/api/now/table/incident",
      "method": "POST",
      "authentication": {
        "type": "none"
      },
      "headers": [
        {
          "key": "Accept",
          "value": "application/json",
          "overridable": false
        },
        {
          "key": "Content-Type",
          "value": "application/json",
          "overridable": false
        },
        {
          "key": "Authorization",
          "value": "Basic {{ get_secret('servicenow_basic_auth_token') }}",
          "overridable": false
        }
      ],
      "query_parameters": [
        {
          "key": "sysparm_exclude_reference_link",
          "value": "true",
          "overridable": false
        }
      ],
      "response_content_type": "application/json"
    },
    {
      "name": "ServiceNow Case Escalate",
      "permalink": "servicenow-case-escalate",
      "url": "https://dev438610.service-now.com/api/now/table/incident/{{ pathParams.sys_id }}",
      "method": "PATCH",
      "authentication": {
        "type": "none"
      },
      "path_parameters": [
        {
          "key": "sys_id"
        }
      ],
      "headers": [
        {
          "key": "Accept",
          "value": "application/json",
          "overridable": false
        },
        {
          "key": "Content-Type",
          "value": "application/json",
          "overridable": false
        },
        {
          "key": "Authorization",
          "value": "Basic {{ get_secret('servicenow_basic_auth_token') }}",
          "overridable": false
        }
      ],
      "response_content_type": "application/json"
    }
  ],
  "composite_connectors": [
    {
      "name": "Country Lookup",
      "permalink": "country-lookup",
      "steps": [
        {
          "name": "all-countries",
          "url": "https://restcountries.com/v3.1/all",
          "method": "GET",
          "query_parameters": [
            {
              "key": "fields",
              "value": "name,region",
              "overridable": false
            }
          ]
        },
        {
          "name": "europe-countries",
          "url": "https://restcountries.com/v3.1/region/europe",
          "method": "GET",
          "query_parameters": [
            {
              "key": "fields",
              "value": "name,capital,population",
              "overridable": false
            }
          ]
        }
      ]
    }
  ]
}
